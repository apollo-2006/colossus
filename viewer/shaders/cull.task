#version 460
// Task shader: one workgroup per work item, one invocation per cluster.
// Each cluster is drawn if it is the right LOD for its distance (see
// include/dag.hpp), inside the view, and facing the camera; the survivors
// get numbers in the visible list and a mesh shader workgroup each.
#extension GL_EXT_mesh_shader : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#include "common.glsl"

layout(local_size_x = 64) in;

struct Payload {
    uint base;  // Mesh workgroup k draws visible[base + k]
};
taskPayloadSharedEXT Payload payload;

shared uint survivors;
shared uint base_slot;

void main() {
    const uint item = gl_WorkGroupID.y * 65535u + gl_WorkGroupID.x;
    const uint lane = gl_LocalInvocationIndex;
    if (lane == 0u) survivors = 0u;
    barrier();

    bool draw = false;
    bool tested = false;
    uint instance_id = 0u, cluster_id = 0u, triangles = 0u;
    if (item < min(work_count, frame.max_work_items)) {
        const WorkItem w = work[item];
        const Instance inst = instances[w.instance];
        const Mesh m = meshes[inst.mesh];
        instance_id = w.instance;
        cluster_id = w.first + lane;
        if (cluster_id < m.first_cluster + m.cluster_count) {
            tested = true;
            const Cluster c = clusters[cluster_id];
            const float s = inst.scale;
            const float tau = frame.lod_threshold;
            draw = projected_error(to_world(inst, c.lod_center), c.lod_radius * s, c.lod_error * s) <= tau &&
                   projected_error(to_world(inst, c.parent_center), c.parent_radius * s, c.parent_error * s) > tau;
            const vec3 center = to_world(inst, c.center);
            const float r = c.radius * s;
            if (draw && (frame.flags & flag_frustum_culling) != 0u) draw = sphere_in_frustum(center, r);
            // Every triangle faces away when the view direction lies inside
            // the cone around the axis: see include/dag.hpp.
            if (draw && (frame.flags & flag_cone_culling) != 0u && c.cone_cutoff < 1.0) {
                const vec3 axis = normalize(to_world_dir(inst, c.cone_axis));
                const vec3 view = center - frame.cull_origin.xyz;
                if (dot(view, axis) >= c.cone_cutoff * length(view) + r) draw = false;
            }
            triangles = draw ? c.triangle_count : 0u;
        }
    }

    const uint tested_n = subgroupAdd(tested ? 1u : 0u);
    const uint triangles_n = subgroupAdd(triangles);
    if (subgroupElect()) {
        atomicAdd(stats.clusters_tested, tested_n);
        atomicAdd(stats.triangles_drawn, triangles_n);
    }

    uint slot = 0u;
    if (draw) slot = atomicAdd(survivors, 1u);
    barrier();
    if (lane == 0u) {
        base_slot = survivors > 0u ? atomicAdd(visible_count, survivors) : 0u;
        payload.base = base_slot;
        atomicAdd(stats.clusters_drawn, survivors);
    }
    barrier();
    uint count = survivors;
    if (base_slot + count > frame.max_visible) {
        if (lane == 0u) atomicAdd(stats.visible_overflow, 1u);
        count = base_slot < frame.max_visible ? frame.max_visible - base_slot : 0u;
    }
    if (draw && slot < count) visible[base_slot + slot] = uvec2(instance_id, cluster_id);
    EmitMeshTasksEXT(count, 1, 1);
}
