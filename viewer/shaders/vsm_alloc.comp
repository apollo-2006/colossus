#version 460
// gives needed shadow pages physical pages, by step (push.level):
//
// 0. per slot: a page the window left loses its physical page. a needed
//    resident page is touched, and listed if invalidated; a needed missing one
//    is requested.
// 1. per physical page: those unused this frame are listed, free first, then
//    those holding an old page.
// 2. per request: the next listed physical page, evicting its old page.
//    requests past the list wait; shading falls back a level.
//
// anything given a physical page or invalidated is listed to render.
//
// step 3 runs first, a workgroup per moving instance: it invalidates every
// resident page its sphere reaches, where it was and where it is. a few hundred
// pages over the fine levels, so the workgroup shares them.
#include "common.glsl"
#include "vsm.glsl"

layout(local_size_x = 64) in;

// per level bounds as unsigned maxima, so zero means empty: x, y store (1 <<
// 21) - (page + (1 << 20)); z, w page + (1 << 20).
void render(uint slot, uint layer) {
    vsm_list[3u * vsm_slots + atomicAdd(vsm_render_count, 1u)] = slot | (layer << 31);
    const uint level = slot / (vsm_window * vsm_window);
    const ivec2 page = vsm_slot_page(slot);
    atomicOr(vsm_render_mask[vsm_mask_word(layer, slot)], 1u << (slot % vsm_window));
    atomicOr(vsm_rendered_levels[layer], 1u << level);
    const ivec2 biased = page + (1 << 20);
    const uint r = layer * vsm_levels + level;
    atomicMax(vsm_render_rect[r].x, (1 << 21) - biased.x);
    atomicMax(vsm_render_rect[r].y, (1 << 21) - biased.y);
    atomicMax(vsm_render_rect[r].z, biased.x);
    atomicMax(vsm_render_rect[r].w, biased.y);
}

// a new page: both layers (moving only if anything moves).
void render_new(uint slot) {
    render(slot, vsm_still);
    if ((frame.flags & flag_moving) != 0u) render(slot, vsm_moving);
}

// the fastest any point of a moving instance goes, world units a second: animate()'s turn (0.7
// rad/s about its origin) and drift (0.2 round a circle at 0.9 rad/s), deform()'s sway and
// ripple (at most 1.3 a + 2.2 b of the radius a second), and a skinned pose's fastest point.
float mover_speed(Instance inst, Mesh m) {
    float speed = 0.0;
    if ((inst.anim & 512u) != 0u) {
        const vec3 origin = vec3(inst.rows[0].w, inst.rows[1].w, inst.rows[2].w);
        speed += 0.7 * (length(to_world(inst, m.bounds.xyz) - origin) + instance_sphere(inst, m.bounds, false).w * inst.scale) + 0.18;
    }
    if (skinned(inst)) speed += pose_info[pose_slot(inst)].z * inst.scale;
    else if (deforming(inst)) speed += (1.3 * deform_a + 2.2 * deform_b) * m.bounds.w * inst.scale;
    return speed;
}

// marks the moving layer of the pages a sphere covers for redrawing. a coarse level's texels are
// wide against a frame's movement, so there it marks only every k frames, k the frames the mover
// takes to move half a texel (at most 8), over the sphere grown by that much: what a page shows
// is never more than half a texel behind.
void invalidate(vec3 world_center, float radius, float speed, uint lane) {
    const vec2 center = vsm_light_space(world_center).xy;
    const ivec2 window = ivec2(vsm_window / 2u);
    const float step = speed * max(frame.time - frame.prev_time, 1e-4);  // per frame
    for (uint level = 0u; level < vsm_levels; ++level) {
        const uint every = uint(clamp(floor(0.5 * vsm_texel(level) / max(step, 1e-9)), 1.0, 8.0));
        if (frame.frame_index % every != 0u) continue;
        const float reach = radius + step * float(every);
        const float size = vsm_texel(level) * float(vsm_page);
        const ivec2 c = vsm_center(level);
        const ivec2 lo = max(ivec2(floor((center - reach) / size)), c - window);
        const ivec2 hi = min(ivec2(floor((center + reach) / size)), c + window - 1);
        if (any(greaterThan(lo, hi))) continue;
        const uint width = uint(hi.x - lo.x + 1), count = width * uint(hi.y - lo.y + 1);
        for (uint k = lane; k < count; k += 64u) {
            const ivec2 page = lo + ivec2(k % width, k / width);
            const uint slot = vsm_slot(level, page);
            if (vsm_entries[slot].phys != vsm_none && vsm_entries[slot].tag == vsm_tag(page))
                atomicOr(vsm_entries[slot].flags, vsm_dirty);
        }
    }
}

void main() {
    const uint k = gl_GlobalInvocationID.y * 65535u * 64u + gl_GlobalInvocationID.x;
    const uint pages = frame.vsm_atlas_side * frame.vsm_atlas_side;
    if (push.level == 3u) {
        const uint group = gl_WorkGroupID.y * 65535u + gl_WorkGroupID.x;
        if (group >= moving_instances.length()) return;
        const uint i = moving_instances[group];
        const Instance now = load_instance(i), then = load_prev_instance(i);
        const Mesh m = meshes[now.mesh];
        const vec4 sphere = instance_sphere(now, m.bounds, false);
        const float radius = sphere.w * now.scale;
        const float speed = mover_speed(now, m);
        // skinned: the sphere grown by a step of the speed (invalidate()) already holds last
        // frame's.
        if (!skinned(now)) invalidate(to_world(then, m.bounds.xyz), radius, speed, gl_LocalInvocationIndex);
        invalidate(to_world(now, sphere.xyz), radius, speed, gl_LocalInvocationIndex);
    } else if (push.level == 0u) {
        if (k >= vsm_slots) return;
        const VsmEntry e = vsm_entries[k];
        const uint tag = vsm_tag(vsm_slot_page(k));
        const bool resident = e.phys != vsm_none && e.tag == tag;
        if (e.phys != vsm_none && !resident) {
            vsm_phys[e.phys].owner = vsm_none;
            vsm_entries[k].phys = vsm_none;
        }
        if (e.needed != frame.frame_index) return;
        if (resident) {
            vsm_phys[e.phys].last_used = frame.frame_index;
            if ((e.flags & (vsm_dirty | vsm_provisional)) != 0u) {
                atomicAnd(vsm_entries[k].flags, ~(vsm_dirty | vsm_provisional));
                if ((e.flags & vsm_provisional) != 0u) render(k, vsm_still);
                if ((e.flags & vsm_dirty) != 0u) render(k, vsm_moving);
            }
        } else {
            vsm_list[atomicAdd(vsm_request_count, 1u)] = k;
        }
    } else if (push.level == 1u) {
        if (k >= pages) return;
        const VsmPhys p = vsm_phys[k];
        if (p.last_used == frame.frame_index) return;
        // free pages first, then those unneeded longest: a page needed every few frames (taa's
        // jitter moves the marked edge) would otherwise be evicted and redrawn over and over.
        if (p.owner == vsm_none) vsm_list[vsm_slots + atomicAdd(vsm_unowned_count, 1u)] = k;
        else if (frame.frame_index - p.last_used >= vsm_stale) vsm_list[2u * vsm_slots + atomicAdd(vsm_evictable_count, 1u)] = k;
        else vsm_list[2u * vsm_slots + vsm_slots / 2u + atomicAdd(vsm_recent_count, 1u)] = k;
    } else {
        if (k >= vsm_request_count) return;
        const uint unowned = vsm_unowned_count;
        const uint stale = vsm_evictable_count;
        if (k >= unowned + stale + vsm_recent_count) {
            atomicAdd(vsm_overflow, 1u);
            return;
        }
        const uint p = k < unowned           ? vsm_list[vsm_slots + k]
                     : k < unowned + stale   ? vsm_list[2u * vsm_slots + k - unowned]
                                             : vsm_list[2u * vsm_slots + vsm_slots / 2u + k - unowned - stale];
        // the old page went unneeded this frame: nothing else touches it.
        const uint old = vsm_phys[p].owner;
        if (old != vsm_none) vsm_entries[old].phys = vsm_none;
        const uint slot = vsm_list[k];
        vsm_entries[slot] = VsmEntry(vsm_tag(vsm_slot_page(slot)), p, frame.frame_index, 0u);
        vsm_phys[p] = VsmPhys(slot, frame.frame_index);
        render_new(slot);
    }
}
