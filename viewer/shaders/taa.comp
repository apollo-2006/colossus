#version 460
// temporal antialiasing. each frame's projection has a different sub-pixel
// offset (halton, main.cpp); pixels blend with last frame's, so edges settle to
// the average: about eight samples a pixel.
//
// last frame's colour by reprojection: the surface under the pixel (depth from
// the visibility buffer), moved through its instance's last transform if
// moving, projected with last frame's camera. exact but for disocclusion, which
// the clamp handles: history held to this frame's 3x3 neighbourhood range
// (ycocg).
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 13, rgba16f) uniform readonly image2D current;
layout(set = 0, binding = 21) uniform sampler2D history;
layout(set = 0, binding = 22, rgba16f) uniform writeonly image2D resolved;

vec3 to_ycocg(vec3 c) {
    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b, -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 from_ycocg(vec3 c) {
    return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z);
}

// last frame's image at uv through catmull-rom: sharper than bilinear, which
// blurs history further each moving frame. five bilinear taps (the 4x4 corners
// carry little weight), after jimenez's smaa 1tx.
vec3 history_at(vec2 uv) {
    const vec2 size = vec2(frame.width, frame.height);
    const vec2 p = uv * size;
    const vec2 center = floor(p - 0.5) + 0.5;
    const vec2 f = p - center;
    const vec2 f2 = f * f, f3 = f2 * f;
    const vec2 w0 = -0.5 * f3 + f2 - 0.5 * f;
    const vec2 w1 = 1.5 * f3 - 2.5 * f2 + 1.0;
    const vec2 w2 = -1.5 * f3 + 2.0 * f2 + 0.5 * f;
    const vec2 w3 = 0.5 * f3 - 0.5 * f2;
    const vec2 w12 = w1 + w2;
    const vec2 t0 = (center - 1.0) / size, t3 = (center + 2.0) / size;
    const vec2 t12 = (center + w2 / w12) / size;
    vec3 c = texture(history, vec2(t12.x, t0.y)).rgb * (w12.x * w0.y);
    c += texture(history, vec2(t0.x, t12.y)).rgb * (w0.x * w12.y);
    c += texture(history, t12).rgb * (w12.x * w12.y);
    c += texture(history, vec2(t3.x, t12.y)).rgb * (w3.x * w12.y);
    c += texture(history, vec2(t12.x, t3.y)).rgb * (w12.x * w3.y);
    const float w = w12.x * w0.y + w0.x * w12.y + w12.x * w12.y + w3.x * w12.y + w12.x * w3.y;
    return max(c / w, vec3(0.0));
}

void main() {
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(frame.width) || px.y >= int(frame.height)) return;
    const vec3 c = imageLoad(current, px).rgb;
    if ((frame.flags & flag_taa) == 0u || frame.taa_valid == 0u || frame.debug_mode != 0u) {
        imageStore(resolved, px, vec4(c, 1.0));
        return;
    }
    vec3 lo = to_ycocg(c), hi = lo;
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x) {
            const ivec2 q = clamp(px + ivec2(x, y), ivec2(0), ivec2(frame.width, frame.height) - 1);
            const vec3 n = to_ycocg(imageLoad(current, q).rgb);
            lo = min(lo, n);
            hi = max(hi, n);
        }

    // where this pixel's surface was on screen last frame.
    const vec2 ndc = (vec2(px) + 0.5) / vec2(frame.width, frame.height) * 2.0 - 1.0;
    const vec4 near_point = frame.inv_view_proj * vec4(ndc, 1.0, 1.0);
    const vec3 dir = normalize(near_point.xyz / near_point.w - frame.origin.xyz);
    const uint64_t v = vis[px.x + px.y * int(frame.width)];
    vec4 prev;
    if (v != 0ul) {
        const vec4 center = frame.inv_view_proj * vec4(0.0, 0.0, 1.0, 1.0);
        const vec3 forward = normalize(center.xyz / center.w - frame.origin.xyz);
        const float t = frame.near_z / uintBitsToFloat(uint(v >> 32)) / dot(dir, forward);
        vec3 p = frame.origin.xyz + dir * t;
        const uint instance = visible[uint(v & 0xffffffffu) >> 7].x;
        const Instance inst = load_instance(instance);
        if (skinned(inst)) {
            // no inverse: the pixel's weights on its triangle, drawn now, applied to the
            // triangle's corners posed as last frame.
            const Cluster c = load_cluster(visible[uint(v & 0xffffffffu) >> 7].y);
            const uint base = page_table[c.group];
            const uint tri = cluster_triangle(base, c, uint(v) & 127u);
            const uint i0 = tri & 255u, i1 = (tri >> 8) & 255u, i2 = (tri >> 16) & 255u;
            const vec4 grid = meshes[inst.mesh].grid;
            const vec3 r0 = cluster_position(base, c, grid, i0), r1 = cluster_position(base, c, grid, i1),
                       r2 = cluster_position(base, c, grid, i2);
            const vec3 a = skin_point(inst, base, c, i0, r0, false), b = skin_point(inst, base, c, i1, r1, false),
                       e = skin_point(inst, base, c, i2, r2, false);
            // moller-trumbore against the posed triangle, in model space.
            const vec3 o = from_world(inst, frame.origin.xyz), d = from_world(inst, frame.origin.xyz + dir) - o;
            const vec3 e1 = b - a, e2 = e - a, pv = cross(d, e2), tv = o - a;
            const float det = dot(e1, pv), inv = abs(det) > 1e-20 ? 1.0 / det : 0.0;
            const float bu = dot(tv, pv) * inv, bv = dot(d, cross(tv, e1)) * inv;
            const vec3 then = skin_point(inst, base, c, i0, r0, true) * (1.0 - bu - bv) + skin_point(inst, base, c, i1, r1, true) * bu +
                              skin_point(inst, base, c, i2, r2, true) * bv;
            p = to_world(load_prev_instance(instance), then);
        } else if (inst.anim != 0u) {
            const vec4 bounds = meshes[inst.mesh].bounds;
            const vec3 rest = undeform(inst, bounds, from_world(inst, p), frame.time);
            p = to_world(load_prev_instance(instance), deform(inst, bounds, rest, frame.prev_time));
        }
        prev = frame.prev_view_proj * vec4(p, 1.0);
    } else if (dir.y < 0.0) {
        prev = frame.prev_view_proj * vec4(frame.origin.xyz + dir * (-frame.origin.y / dir.y), 1.0);
    } else {
        prev = frame.prev_view_proj * vec4(dir, 0.0);  // sky: a direction at infinity
    }
    // found along the nudged ray; removing the nudge lets a still camera read
    // history at pixel centres, unresampled.
    const vec2 uv = (prev.xy / prev.w + frame.jitter) * 0.5 + 0.5;
    if (prev.w <= 0.0 || any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) {
        imageStore(resolved, px, vec4(c, 1.0));
        return;
    }
    const vec3 h = from_ycocg(clamp(to_ycocg(history_at(uv)), lo, hi));
    imageStore(resolved, px, vec4(mix(h, c, 0.1), 1.0));
}
