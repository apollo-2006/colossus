#version 460
// rasterizes clusters into the shadow pages being rendered, like
// sw_raster.comp: a workgroup per cluster, an invocation per vertex then per
// triangle. texels of the cluster's level, snapped to 1/16, edges from each
// triangle's corner; triangles over 1024 texels would overflow and are dropped
// (none come near). the walk is clipped to the level's rendered pages and skips
// pages not rendering. a triangle over 64 texels after clipping is drawn by the
// whole workgroup instead, a texel an invocation. depth by atomic max, nearest
// the sun wins. sun facing triangles only.
#include "common.glsl"
#include "vsm.glsl"

layout(local_size_x = 128) in;

shared ivec2 snapped[128];  // texels, 1/16
shared float depth[128];
shared uint together[128];  // triangles for the whole workgroup
shared uint together_count;

int edge(ivec2 a, ivec2 b, ivec2 p) {
    return (b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x);
}

bool owns_edge(ivec2 a, ivec2 b) {
    const ivec2 d = b - a;
    return d.y < 0 || (d.y == 0 && d.x > 0);
}

// a triangle set up for the walk: corners relative to lo_abs * 16, wound positive, and the
// clipped box of texels to visit, [start, hi] from lo_abs.
struct Tri {
    ivec2 a, b, d;
    float za, zb, zd;
    ivec2 lo_abs, start, hi;
    int area, bias0, bias1, bias2;
};

bool setup(uint packed, uint level, uint layer, bool two_sided, out Tri tri) {
    const uint i0 = packed & 255u, i1 = (packed >> 8) & 255u, i2 = (packed >> 16) & 255u;
    tri.a = snapped[i0];
    tri.b = snapped[i1];
    tri.d = snapped[i2];
    tri.za = depth[i0];
    tri.zb = depth[i1];
    tri.zd = depth[i2];
    // texel centres at n + 0.5: the box of centres inside.
    tri.lo_abs = (min(tri.a, min(tri.b, tri.d)) - 8 + 15) >> 4;
    const ivec2 hi_abs = (max(tri.a, max(tri.b, tri.d)) - 8) >> 4;
    if (any(greaterThan(tri.lo_abs, hi_abs)) || any(greaterThan(hi_abs - tri.lo_abs, ivec2(1023)))) return false;
    const ivec2 origin = tri.lo_abs * 16;
    tri.a -= origin;
    tri.b -= origin;
    tri.d -= origin;
    // sun facing only (counterclockwise seen from the sun): a closed surface's far side is never
    // nearer the sun, and shading leaves faces turned away dark anyway. through a scan's holes
    // this lets a little light in. a double sided material's thin surfaces (leaves, needles)
    // cast from either side: turned round.
    tri.area = edge(tri.a, tri.b, tri.d);
    if (tri.area < 0 && two_sided) {
        const ivec2 sb = tri.b;
        tri.b = tri.d;
        tri.d = sb;
        const float zb = tri.zb;
        tri.zb = tri.zd;
        tri.zd = zb;
        tri.area = -tri.area;
    }
    if (tri.area <= 0) return false;
    // the box, clipped to the pages rendering at this level.
    const ivec4 rect = vsm_rendered(layer, level);
    tri.start = max(tri.lo_abs, rect.xy * int(vsm_page)) - tri.lo_abs;
    tri.hi = min(hi_abs, rect.zw * int(vsm_page) + int(vsm_page) - 1) - tri.lo_abs;
    if (any(greaterThan(tri.start, tri.hi))) return false;
    tri.bias0 = owns_edge(tri.b, tri.d) ? 0 : -1;
    tri.bias1 = owns_edge(tri.d, tri.a) ? 0 : -1;
    tri.bias2 = owns_edge(tri.a, tri.b) ? 0 : -1;
    return true;
}

// the page's physical page if it renders, else vsm_none.
uint rendering(uint level, uint layer, ivec2 page) {
    if (!vsm_in_window(level, page)) return vsm_none;
    const uint slot = vsm_slot(level, page);
    return vsm_renders(layer, slot) ? vsm_entries[slot].phys : vsm_none;
}

void store(uint phys, uint layer, ivec2 at, float z) {
    const uint index = vsm_atlas_index(phys, uvec2(at & ivec2(int(vsm_page) - 1)), layer);
    const uint value = vsm_sortable(z);
    if (value > vsm_atlas[index]) atomicMax(vsm_atlas[index], value);
}

void mark_moving(uint level, uint layer, ivec2 page) {
    if (layer == vsm_moving) atomicOr(vsm_entries[vsm_slot(level, page)].flags, vsm_has_moving);
}

// one invocation: rows, a page's span at a time.
void walk(Tri tri, uint level, uint layer) {
    const ivec2 p0 = tri.start * 16 + 8;
    int row0 = edge(tri.b, tri.d, p0) + tri.bias0, row1 = edge(tri.d, tri.a, p0) + tri.bias1, row2 = edge(tri.a, tri.b, p0) + tri.bias2;
    const int dx0 = (tri.d.y - tri.b.y) * -16, dy0 = (tri.d.x - tri.b.x) * 16;
    const int dx1 = (tri.a.y - tri.d.y) * -16, dy1 = (tri.a.x - tri.d.x) * 16;
    const int dx2 = (tri.b.y - tri.a.y) * -16, dy2 = (tri.b.x - tri.a.x) * 16;
    const float inv_area = 1.0 / float(tri.area);
    for (int y = tri.start.y; y <= tri.hi.y; ++y) {
        int w0 = row0, w1 = row1, w2 = row2;
        int x = tri.start.x;
        while (x <= tri.hi.x) {
            const ivec2 at0 = tri.lo_abs + ivec2(x, y);
            const ivec2 page = at0 >> 7;
            const int span = min(tri.hi.x - x + 1, int(vsm_page) - (at0.x & (int(vsm_page) - 1)));
            const uint phys = rendering(level, layer, page);
            if (phys == vsm_none) {
                w0 += dx0 * span;
                w1 += dx1 * span;
                w2 += dx2 * span;
                x += span;
                continue;
            }
            bool drew = false;
            for (const int e = x + span; x < e; ++x) {
                if ((w0 | w1 | w2) >= 0) {
                    const float z = (float(w0 - tri.bias0) * tri.za + float(w1 - tri.bias1) * tri.zb + float(w2 - tri.bias2) * tri.zd) * inv_area;
                    store(phys, layer, tri.lo_abs + ivec2(x, y), z);
                    drew = true;
                }
                w0 += dx0;
                w1 += dx1;
                w2 += dx2;
            }
            if (drew) mark_moving(level, layer, page);
        }
        row0 += dy0;
        row1 += dy1;
        row2 += dy2;
    }
}

// the whole workgroup: a page at a time, a texel an invocation.
void walk_together(Tri tri, uint level, uint layer) {
    const float inv_area = 1.0 / float(tri.area);
    const ivec2 page_lo = (tri.lo_abs + tri.start) >> 7, page_hi = (tri.lo_abs + tri.hi) >> 7;
    for (int py = page_lo.y; py <= page_hi.y; ++py)
        for (int px = page_lo.x; px <= page_hi.x; ++px) {
            const uint phys = rendering(level, layer, ivec2(px, py));  // uniform
            if (phys == vsm_none) continue;
            const ivec2 lo = max(ivec2(px, py) * int(vsm_page) - tri.lo_abs, tri.start);
            const ivec2 hi = min(ivec2(px, py) * int(vsm_page) + int(vsm_page) - 1 - tri.lo_abs, tri.hi);
            const ivec2 size = hi - lo + 1;
            bool drew = false;
            for (uint i = gl_LocalInvocationIndex; i < uint(size.x * size.y); i += 128u) {
                const ivec2 q = lo + ivec2(int(i) % size.x, int(i) / size.x);
                const ivec2 p = q * 16 + 8;
                const int w0 = edge(tri.b, tri.d, p) + tri.bias0, w1 = edge(tri.d, tri.a, p) + tri.bias1, w2 = edge(tri.a, tri.b, p) + tri.bias2;
                if ((w0 | w1 | w2) < 0) continue;
                const float z = (float(w0 - tri.bias0) * tri.za + float(w1 - tri.bias1) * tri.zb + float(w2 - tri.bias2) * tri.zd) * inv_area;
                store(phys, layer, tri.lo_abs + q, z);
                drew = true;
            }
            if (drew) mark_moving(level, layer, ivec2(px, py));
        }
}

void main() {
    const uint k = gl_WorkGroupID.y * 65535u + gl_WorkGroupID.x;
    if (k >= min(vsm_visible_count, frame.max_visible)) return;  // uniform
    const uvec2 v = vsm_visible[k];
    const uint instance = v.x & 0xffffffu, level = (v.x >> 24) & 15u, layer = v.x >> 28;
    const Instance inst = load_instance(instance);
    const bool two_sided = (meshes[inst.mesh].tex.z & 1u) != 0u;
    const Cluster c = load_cluster(v.y);
    const uint t = gl_LocalInvocationIndex;
    const float texel = vsm_texel(level);
    if (t == 0u) together_count = 0u;
    if (t < c.vertex_count) {
        const Mesh m = meshes[inst.mesh];
        const vec3 p = vsm_light_space(to_world(inst, drawn_vertex(inst, page_table[c.group], c, t)));
        snapped[t] = ivec2(round(p.xy / texel * 16.0));
        depth[t] = p.z;
    }
    barrier();
    Tri tri;
    if (t < c.triangle_count && setup(cluster_triangle(page_table[c.group], c, t), level, layer, two_sided, tri)) {
        const ivec2 size = tri.hi - tri.start + 1;
        if (size.x * size.y > 64) together[atomicAdd(together_count, 1u)] = t;
        else walk(tri, level, layer);
    }
    barrier();
    const uint count = together_count;
    for (uint j = 0u; j < count; ++j) {
        setup(cluster_triangle(page_table[c.group], c, together[j]), level, layer, two_sided, tri);
        walk_together(tri, level, layer);
    }
}
