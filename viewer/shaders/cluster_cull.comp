#version 460
// Cluster culling: one workgroup per work item, one invocation per cluster.
// Each cluster is drawn if it is the right LOD for its distance (see
// include/dag.hpp), inside the view, facing the camera and not hidden; the
// survivors are appended to the visible list, which the mesh shaders draw.
//
// This was a task shader at first, emitting mesh workgroups directly. On
// RADV, task workgroups cost enough each that testing 630k clusters took
// 1.1 ms; as plain compute it takes a fraction of that.
//
// Pass 1 tests occlusion against last frame's depth, and lists what it
// finds hidden. Pass 2 takes its own work items (instances pass 1 found
// hidden) and then that list, 64 to a workgroup, and tests them against the
// depth pass 1 drew: what was hidden last frame but is seen now is drawn.
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#include "common.glsl"

layout(local_size_x = 64) in;

void main() {
    const uint pass = push.pass;
    const uint group = gl_WorkGroupID.y * 65535u + gl_WorkGroupID.x;
    const uint lane = gl_LocalInvocationIndex;

    bool draw = false, tested = false, hidden = false, wants_finer = false;
    float self_error = 0.0;
    uint instance_id = 0u, cluster_id = 0u, triangles = 0u;
    const uint items = cull_args[pass].w;
    if (group < items) {
        // A work item: 64 clusters of one instance, tested in full.
        const WorkItem w = work[pass * frame.max_work_items + group];
        const Instance inst = load_instance(w.instance);
        const Mesh m = meshes[inst.mesh];
        instance_id = w.instance;
        cluster_id = w.first + lane;
        if (cluster_id < m.first_cluster + m.cluster_count) {
            tested = true;
            const Cluster c = clusters[cluster_id];
            const float s = inst.scale;
            draw = lod_test(inst, c, wants_finer, self_error);
            const vec3 center = to_world(inst, c.center);
            const float r = c.radius * s;
            if (draw && (frame.flags & flag_frustum_culling) != 0u) draw = sphere_in_frustum(center, r);
            // Every triangle faces away when the view direction lies inside
            // the cone around the axis: see include/dag.hpp.
            if (draw && (frame.flags & flag_cone_culling) != 0u && c.cone_cutoff < 1.0) {
                const vec3 axis = normalize(to_world_dir(inst, c.cone_axis));
                const vec3 view = center - frame.cull_origin.xyz;
                if (dot(view, axis) >= c.cone_cutoff * length(view) + r) draw = false;
            }
            // Pass 1 asks whether it was hidden last frame, where last
            // frame was.
            const vec3 then = pass == 0u && inst.anim != 0u ? to_world(load_prev_instance(w.instance), c.center) : center;
            if (draw && occluded(then, r)) {
                draw = false;
                hidden = true;
            }
        }
    } else if (pass == 1u) {
        // A piece of pass 1's hidden clusters: only occlusion is left to test.
        const uint k = (group - items) * 64u + lane;
        if (k < min(late_cluster_count, frame.max_visible)) {
            tested = true;
            const uvec2 ic = late_clusters[k];
            instance_id = ic.x;
            cluster_id = ic.y;
            const Instance inst = load_instance(instance_id);
            const Cluster c = clusters[cluster_id];
            draw = !occluded(to_world(inst, c.center), c.radius * inst.scale);
            hidden = !draw;
            if (draw) lod_test(inst, c, wants_finer, self_error);
        }
    }
    if (draw) {
        const Cluster c = clusters[cluster_id];
        triangles = c.triangle_count;
        // For the streamer: this page is in use, and this cluster would
        // rather be finer clusters that are not loaded.
        page_used[c.group] = frame.frame_index;
        if (wants_finer) request_finer(c, self_error);
    }
    if (hidden && pass == 0u) {
        const uint k = atomicAdd(late_cluster_count, 1u);
        if (k < frame.max_visible) late_clusters[k] = uvec2(instance_id, cluster_id);
    }

    const uint tested_n = subgroupAdd(tested ? 1u : 0u);
    const uint triangles_n = subgroupAdd(triangles);
    const uint hidden_n = subgroupAdd(hidden ? 1u : 0u);
    const uint drawn_n = subgroupAdd(draw ? 1u : 0u);
    if (subgroupElect()) {
        atomicAdd(stats.clusters_tested, tested_n);
        atomicAdd(stats.triangles_drawn, triangles_n);
        if (pass == 0u) atomicAdd(stats.clusters_occluded, hidden_n);
        else atomicAdd(stats.clusters_late, drawn_n);
    }

    // Small clusters go to the software rasterizer: their triangles are a
    // pixel or two, which the hardware rasterizer handles poorly. Clusters
    // reaching the near plane always go to the hardware, which clips.
    bool software = false;
    if (draw && (frame.flags & flag_software_raster) != 0u) {
        const Instance inst = load_instance(instance_id);
        const Cluster c = clusters[cluster_id];
        vec3 vc = (frame.view * vec4(to_world(inst, c.center), 1.0)).xyz;
        vc.z = -vc.z;
        vec4 aabb;
        if (project_sphere(vc, c.radius * inst.scale, aabb)) {
            const vec2 size = (aabb.zw - aabb.xy) * vec2(frame.width, frame.height);
            software = max(size.x, size.y) < frame.sw_max_pixels;
        }
    }
    const bool hw = draw && !software;

    // Survivors take consecutive slots: one atomic per subgroup per list.
    const uint hw_n = subgroupAdd(hw ? 1u : 0u);
    const uint sw_n = subgroupAdd(software ? 1u : 0u);
    uint hw_base = 0u, sw_base = 0u;
    if (subgroupElect()) {
        if (hw_n > 0u) hw_base = atomicAdd(visible_count, hw_n);
        if (sw_n > 0u) sw_base = atomicAdd(sw_count, sw_n);
        atomicAdd(stats.clusters_drawn, hw_n + sw_n);
        atomicAdd(stats.clusters_software, sw_n);
    }
    hw_base = subgroupBroadcastFirst(hw_base);
    sw_base = subgroupBroadcastFirst(sw_base);
    const uint hw_rank = subgroupExclusiveAdd(hw ? 1u : 0u);
    const uint sw_rank = subgroupExclusiveAdd(software ? 1u : 0u);
    if (hw) {
        const uint slot = hw_base + hw_rank;
        if (slot < frame.max_visible) visible[slot] = uvec2(instance_id, cluster_id);
        else atomicAdd(stats.visible_overflow, 1u);
    }
    if (software) {
        const uint k = sw_base + sw_rank;
        if (k < frame.max_visible) visible[sw_slot(k)] = uvec2(instance_id, cluster_id);
        else atomicAdd(stats.visible_overflow, 1u);
    }
}
