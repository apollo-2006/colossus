#version 460
// software rasterizer: a workgroup per small cluster, an invocation per vertex
// then per triangle. each walks its triangle's box and writes depth and
// triangle into the visibility buffer with the hardware path's 64-bit atomic
// max, so the two mix.
//
// vertices snap to 1/256 pixel like the hardware, but where the two rasterizers
// meet, a vertex can still land a step apart (the hardware doesn't place it
// bit for bit as this shader does), leaving a sliver whose pixel centres
// neither draws. so triangles
// here grow by a step: the depth test settles the overlap, and a silhouette can
// gain a pixel whose centre lies within 1.5/256 of it. edge functions are
// relative to the triangle's corner, staying 32-bit: clusters here are under 64
// pixels, coordinates under 2^14, products under 2^28. (rdna has no 64-bit multiply;
// the 64-bit version lost at every size.)
//
// each pixel reads before its atomic and skips it if something nearer is there,
// like early depth. a stale read is only ever farther, so no needed write is
// skipped.
#extension GL_EXT_shader_atomic_int64 : require
#include "common.glsl"

layout(local_size_x = 128) in;

shared ivec2 screen[128];  // snapped, 1/256 pixel
shared float depth[128];   // reversed: near_z / w

int edge(ivec2 a, ivec2 b, ivec2 p) {
    return (b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x);
}

void main() {
    const uint pass = push.pass;
    const uint k = sw_args[pass].w + gl_WorkGroupID.y * 65535u + gl_WorkGroupID.x;
    if (k >= sw_pass_start[pass + 1u]) return;
    const uint vid = sw_slot(k);
    const uvec2 v = visible[vid];
    const Instance inst = load_instance(v.x);
    const Cluster c = load_cluster(v.y);
    const uint t = gl_LocalInvocationIndex;

    if (t < c.vertex_count) {
        const Mesh m = meshes[inst.mesh];
        const vec3 p = drawn_vertex(inst, page_table[c.group], c, t);
        const vec4 clip = frame.view_proj * vec4(to_world(inst, p), 1.0);
        const vec2 ndc = clip.xy / clip.w;
        const vec2 px = (ndc * 0.5 + 0.5) * vec2(frame.width, frame.height);
        screen[t] = ivec2(round(px * 256.0));
        depth[t] = clip.z / clip.w;
    }
    barrier();
    if (t >= c.triangle_count) return;

    const uint packed = cluster_triangle(page_table[c.group], c, t);
    uint i0 = packed & 255u, i1 = (packed >> 8) & 255u, i2 = (packed >> 16) & 255u;
    ivec2 a = screen[i0], b = screen[i1], d = screen[i2];
    float za = depth[i0], zb = depth[i1], zd = depth[i2];
    // positions now relative to the box's corner pixel (the box widened as the triangle
    // grows: by at most 1.5 steps).
    const ivec2 lo_abs = max((min(a, min(b, d)) - 2 - 128 + 255) >> 8, ivec2(0));
    const ivec2 hi = min((max(a, max(b, d)) + 2 - 128) >> 8, ivec2(frame.width, frame.height) - 1) - lo_abs;
    if (any(lessThan(hi, ivec2(0)))) return;
    const ivec2 origin = lo_abs * 256;
    a -= origin;
    b -= origin;
    d -= origin;
    int area = edge(a, b, d);
    if (area == 0) return;
    // both sides drawn (scans have holes): one winding, edge functions positive
    // inside.
    if (area < 0) {
        const ivec2 tmp = b; b = d; d = tmp;
        const float tz = zb; zb = zd; zd = tz;
        area = -area;
    }

    // edge functions at the first pixel centre, and steps. each edge moves out by a step:
    // an edge function is its length times the distance, and |x| + |y| is at least the
    // length.
    const ivec2 p0 = ivec2(128);
    const int bias0 = abs(d.x - b.x) + abs(d.y - b.y);
    const int bias1 = abs(a.x - d.x) + abs(a.y - d.y);
    const int bias2 = abs(b.x - a.x) + abs(b.y - a.y);
    int row0 = edge(b, d, p0) + bias0, row1 = edge(d, a, p0) + bias1, row2 = edge(a, b, p0) + bias2;
    const int dx0 = (d.y - b.y) * -256, dy0 = (d.x - b.x) * 256;
    const int dx1 = (a.y - d.y) * -256, dy1 = (a.x - d.x) * 256;
    const int dx2 = (b.y - a.y) * -256, dy2 = (b.x - a.x) * 256;
    const float inv_area = 1.0 / float(area);
    const uint64_t id = uint64_t((vid << 7) | t);

    for (int y = 0; y <= hi.y; ++y) {
        int w0 = row0, w1 = row1, w2 = row2;
        const uint row = uint(lo_abs.y + y) * frame.width + uint(lo_abs.x);
        for (int x = 0; x <= hi.x; ++x) {
            if ((w0 | w1 | w2) >= 0) {
                // depth is affine on screen: corners weighted by the unbiased
                // edge functions.
                const float z = (float(w0 - bias0) * za + float(w1 - bias1) * zb + float(w2 - bias2) * zd) * inv_area;
                const uint64_t value = (uint64_t(floatBitsToUint(z)) << 32) | id;
                if (value > vis[row + uint(x)]) atomicMax(vis[row + uint(x)], value);
            }
            w0 += dx0;
            w1 += dx1;
            w2 += dx2;
        }
        row0 += dy0;
        row1 += dy1;
        row2 += dy2;
    }
}
