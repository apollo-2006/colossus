#version 460
// Shades every pixel from the visibility buffer: the triangle it holds is
// fetched again, the camera ray through the pixel center intersected with
// it for exact barycentrics, and the vertex normals interpolated. Pixels
// with nothing drawn get the ground or the sky. Debug modes color by
// cluster, triangle, LOD level, group or instance instead.
//
// Built twice: with RAY_QUERY defined, sunlight is tested with a shadow ray
// against acceleration structures over a coarser cut of each model (see
// build_shadow_scene() in main.cpp).
#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 13, rgba16f) uniform writeonly image2D out_image;

#ifdef RAY_QUERY
#extension GL_EXT_ray_query : require
layout(set = 0, binding = 18) uniform accelerationStructureEXT shadow_scene;
#endif

const vec3 sun_dir = normalize(vec3(0.75, 0.5, 0.3));
const vec3 sun_color = vec3(1.0, 0.92, 0.82) * 1.7;

vec3 sky(vec3 dir) {
    const float t = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);
    return mix(vec3(0.66, 0.68, 0.71), vec3(0.3, 0.42, 0.62), pow(t, 0.7)) * 0.9;
}

vec3 hash_color(uint x) {
    const uint h = hash(x);
    return vec3(float(h & 255u), float((h >> 8) & 255u), float((h >> 16) & 255u)) / 255.0 * 0.8 + 0.1;
}

// Cool to hot over the LOD levels.
vec3 level_color(uint level) {
    const vec3 ramp[8] = vec3[](vec3(0.15, 0.25, 0.9), vec3(0.1, 0.6, 0.95), vec3(0.1, 0.8, 0.6), vec3(0.4, 0.85, 0.2),
                                vec3(0.9, 0.85, 0.15), vec3(0.95, 0.55, 0.1), vec3(0.9, 0.2, 0.15), vec3(0.85, 0.2, 0.7));
    return ramp[min(level, 7u)];
}

vec3 aces(vec3 x) {
    return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
}

vec2 to_pixel(vec3 world) {
    const vec4 clip = frame.view_proj * vec4(world, 1.0);
    return (clip.xy / clip.w * 0.5 + 0.5) * vec2(frame.width, frame.height);
}

// 1 where the sun reaches p, 0 where something is in the way. The ray
// starts `bias` above the surface: the shadow geometry is a coarser copy
// and can stand that far above the surface drawn.
float sunlight(vec3 p, vec3 n, float bias) {
#ifdef RAY_QUERY
    if ((frame.flags & flag_shadows) == 0u) return 1.0;
    rayQueryEXT q;
    rayQueryInitializeEXT(q, shadow_scene, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFFu,
                          p + n * bias, 0.0, sun_dir, 1e4);
    while (rayQueryProceedEXT(q)) {
    }
    return rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionNoneEXT ? 1.0 : 0.0;
#else
    return 1.0;
#endif
}

float edge_distance(vec2 p, vec2 a, vec2 b) {
    const vec2 ab = b - a;
    return abs(ab.x * (p.y - a.y) - ab.y * (p.x - a.x)) / max(length(ab), 1e-6);
}

void main() {
    const uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= frame.width || px.y >= frame.height) return;
    const vec2 ndc = (vec2(px) + 0.5) / vec2(frame.width, frame.height) * 2.0 - 1.0;
    const vec4 near_point = frame.inv_view_proj * vec4(ndc, 1.0, 1.0);
    const vec3 origin = frame.origin.xyz;
    const vec3 dir = normalize(near_point.xyz / near_point.w - origin);

    const uint64_t v = vis[px.x + px.y * frame.width];
    vec3 color;
    if (v == 0ul && frame.debug_mode == 6u) {
        color = vec3(1.0, 0.0, 1.0);  // Holes: anything not drawn
    } else if (v == 0ul) {
        color = sky(dir);
        if (dir.y < 0.0) {
            // The ground: a plane at y = 0 with a faint grid, fading into
            // the sky with distance.
            const float t = -origin.y / dir.y;
            const vec3 hit = origin + dir * t;
            const vec2 cell = abs(fract(hit.xz * 0.5) - 0.5);
            const float line = smoothstep(0.47, 0.5, max(cell.x, cell.y));
            const float lit = t < 200.0 ? sunlight(hit, vec3(0, 1, 0), 1e-3 + t * 1e-5) : 1.0;
            const vec3 ground = mix(vec3(0.42, 0.4, 0.37), vec3(0.33, 0.31, 0.29), line) *
                                (sun_color * max(sun_dir.y, 0.0) * 0.6 * lit + sky(vec3(0, 1, 0)) * 0.45);
            color = mix(ground, color, 1.0 - exp(-t * 0.012));
        }
    } else {
        const uint id = uint(v & 0xffffffffu);
        const uint vid = id >> 7, tri = id & 127u;
        const uvec2 vc = visible[vid];
        const Instance inst = instances[vc.x];
        const Cluster c = clusters[vc.y];
        const uint packed = cluster_triangles[c.triangle_offset + tri];
        const uint i0 = cluster_vertices[c.vertex_offset + (packed & 255u)];
        const uint i1 = cluster_vertices[c.vertex_offset + ((packed >> 8) & 255u)];
        const uint i2 = cluster_vertices[c.vertex_offset + ((packed >> 16) & 255u)];
        const vec3 p0 = to_world(inst, positions[i0]), p1 = to_world(inst, positions[i1]), p2 = to_world(inst, positions[i2]);

        // The ray against the triangle's plane (Moller-Trumbore, without
        // the bounds checks: the rasterizer already said it hits).
        const vec3 e1 = p1 - p0, e2 = p2 - p0;
        const vec3 pv = cross(dir, e2);
        const float det = dot(e1, pv);
        const vec3 tv = origin - p0;
        const float inv = abs(det) > 1e-20 ? 1.0 / det : 0.0;
        const float bu = dot(tv, pv) * inv;
        const vec3 qv = cross(tv, e1);
        const float bv = dot(dir, qv) * inv;
        const float t = dot(e2, qv) * inv;
        const vec3 hit = origin + dir * t;

        vec3 n = normalize(to_world_dir(inst, normals[i0] * (1.0 - bu - bv) + normals[i1] * bu + normals[i2] * bv));
        if (dot(n, dir) > 0.0) n = -n;  // Seen from behind, through a hole in a scan

        vec3 albedo = vec3(0.56, 0.52, 0.47);
        if (frame.debug_mode == 1u) albedo = hash_color(vc.y * 7919u + vc.x * 104729u);
        else if (frame.debug_mode == 2u) albedo = hash_color(id * 2654435761u + vc.x);
        else if (frame.debug_mode == 3u) albedo = level_color(c.level);
        else if (frame.debug_mode == 4u) albedo = hash_color(c.group + vc.x * 104729u);
        else if (frame.debug_mode == 5u) albedo = hash_color(vc.x);
        else if (frame.debug_mode == 6u) albedo = vec3(0.3);
        else if (frame.debug_mode == 7u) albedo = vid >= pass_start[2] ? vec3(0.95, 0.45, 0.1) : vec3(0.15, 0.45, 0.95);

        float diffuse = max(dot(n, sun_dir), 0.0);
        if (diffuse > 0.0) {
            // The shadow copy strays up to its own error from the original,
            // and the drawn cut up to this cluster's: clear both.
            const float bias = (meshes[inst.mesh].shadow_error + c.lod_error) * inst.scale * 1.5 + 1e-4 + t * 2e-5;
            diffuse *= sunlight(hit, n, bias);
        }
        const vec3 ambient = mix(vec3(0.24, 0.22, 0.2), sky(vec3(0, 1, 0)), n.y * 0.5 + 0.5) * 0.42;
        const float rim = pow(1.0 - max(dot(n, -dir), 0.0), 4.0) * 0.25;
        color = albedo * (sun_color * diffuse + ambient) + rim * sky(n);

        if ((frame.flags & flag_wireframe) != 0u) {
            const vec2 p = vec2(px) + 0.5;
            const vec2 s0 = to_pixel(p0), s1 = to_pixel(p1), s2 = to_pixel(p2);
            const float d = min(edge_distance(p, s0, s1), min(edge_distance(p, s1, s2), edge_distance(p, s2, s0)));
            color = mix(color * 0.25, color, smoothstep(0.0, 1.0, d));
        }
        color = mix(color, sky(dir), 1.0 - exp(-t * 0.012));
    }
    imageStore(out_image, ivec2(px), vec4(aces(color), 1.0));
}
