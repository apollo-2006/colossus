#version 460
// Shades every pixel from the visibility buffer (see surface.glsl for how
// the surface under a pixel is found). Pixels with nothing drawn get the
// ground or the sky. Debug modes color by cluster, triangle, LOD level,
// group, instance or rasterizer instead.
//
// Built twice: with RAY_QUERY defined, sunlight is tested against
// acceleration structures over a coarser cut of each model (see
// build_shadow_scene() in main.cpp). shadow.comp traces those rays at half
// resolution; each pixel borrows the answer where its neighbours agree and
// traces its own ray where they do not (see sunlight()).
#include "common.glsl"
#include "surface.glsl"
#include "vsm.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 13, rgba16f) uniform writeonly image2D out_image;

// Instances carry one of these (Instance::material): albedo, roughness,
// metalness.
struct Material {
    vec3 albedo;
    float roughness;
    float metallic;
};
const Material materials[6] = Material[](
    Material(vec3(0.56, 0.52, 0.47), 0.6, 0.0),   // Plaster: the plain look
    Material(vec3(0.66, 0.64, 0.6), 0.3, 0.0),    // Polished marble
    Material(vec3(0.62, 0.5, 0.38), 0.85, 0.0),   // Sandstone
    Material(vec3(0.58, 0.38, 0.22), 0.35, 1.0),  // Bronze
    Material(vec3(0.95, 0.74, 0.36), 0.28, 1.0),  // Gold
    Material(vec3(0.2, 0.2, 0.22), 0.45, 0.0));   // Dark granite

vec3 sky(vec3 dir) {
    const float t = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);
    return mix(vec3(0.66, 0.68, 0.71), vec3(0.3, 0.42, 0.62), pow(t, 0.7)) * 0.9;
}

vec3 hash_color(uint x) {
    const uint h = hash(x);
    return vec3(float(h & 255u), float((h >> 8) & 255u), float((h >> 16) & 255u)) / 255.0 * 0.8 + 0.1;
}

// Cool to hot over the LOD levels: a hue wheel from blue (level 0, full
// detail) through green and yellow to red and magenta (level 16 and up).
vec3 level_color(uint level) {
    const float h = 0.66 - 0.055 * float(min(level, 16u));
    const vec3 k = abs(fract(vec3(h) + vec3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return mix(vec3(1.0), clamp(k - 1.0, 0.0, 1.0), 0.75) * 0.85;
}

vec3 aces(vec3 x) {
    return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
}

vec2 to_pixel(vec3 world) {
    const vec4 clip = frame.view_proj * vec4(world, 1.0);
    return (clip.xy / clip.w * 0.5 + 0.5) * vec2(frame.width, frame.height);
}

// Sunlight at a pixel's surface. Borrowed from the half resolution
// shadows when every neighbour whose surface is at this pixel's distance
// agrees; traced here along shadow edges, where they do not, and wherever
// no neighbour is at this distance (silhouettes). So shadow edges keep
// full resolution, and only they cost a ray.
float sunlight(uvec2 px, Surface s) {
    if ((frame.flags & flag_shadows) == 0u) return 1.0;
    if ((frame.flags & flag_vsm) != 0u) return s.kind == surface_sky ? 1.0 : vsm_shadow(s.hit, s.n, s.t);
#ifdef RAY_QUERY
    if ((frame.flags & flag_full_res_shadows) != 0u) return trace_surface(s);
    const uvec2 size = shadow_size();
    const uvec2 base = px / 2u;
    float lo = 2.0, hi = -1.0;
    for (uint k = 0u; k < 4u; ++k) {
        const uvec2 q = min(base + uvec2(k & 1u, k >> 1), size - 1u);
        const vec2 m = shadow_mask[q.x + q.y * size.x];
        if (m.y > 0.0 && abs(m.y - s.t) < 0.01 * s.t) {
            lo = min(lo, m.x);
            hi = max(hi, m.x);
        }
    }
    return hi >= 0.0 && lo == hi ? lo : trace_surface(s);
#else
    return 1.0;
#endif
}

// Sunlight off a surface: Lambert, plus GGX specular with Schlick's
// Fresnel and a Smith shadowing term.
vec3 shade_material(Material m, vec3 n, vec3 v, float lit) {
    const vec3 f0 = mix(vec3(0.04), m.albedo, m.metallic);
    const float nl = max(dot(n, sun_dir), 0.0), nv = max(dot(n, v), 1e-4);
    const vec3 h = normalize(sun_dir + v);
    const float nh = max(dot(n, h), 0.0), vh = max(dot(v, h), 0.0);
    const float a = m.roughness * m.roughness, a2 = a * a;
    const float d = a2 / (3.14159 * pow(nh * nh * (a2 - 1.0) + 1.0, 2.0));
    const float k = (m.roughness + 1.0) * (m.roughness + 1.0) / 8.0;
    const float g = nl / (nl * (1.0 - k) + k) * nv / (nv * (1.0 - k) + k);
    const vec3 fresnel = f0 + (1.0 - f0) * pow(1.0 - vh, 5.0);
    // Scaled by pi, as the diffuse term leaves out its 1 / pi.
    const vec3 specular = 3.14159 * d * g * fresnel / max(4.0 * nl * nv, 1e-4);
    const vec3 diffuse = m.albedo * (1.0 - m.metallic) * (1.0 - fresnel);
    const vec3 ambient = mix(vec3(0.24, 0.22, 0.2), sky(vec3(0, 1, 0)), n.y * 0.5 + 0.5) * 0.42;
    // Sky seen in the reflection, fading with roughness.
    const vec3 env_f = f0 + (1.0 - f0) * pow(1.0 - nv, 5.0);
    const vec3 env = sky(reflect(-v, n)) * env_f * (1.0 - m.roughness) * 0.8;
    return (diffuse + specular) * sun_color * nl * lit + m.albedo * (1.0 - m.metallic) * ambient + env +
           m.albedo * m.metallic * ambient * 0.5;
}

float edge_distance(vec2 p, vec2 a, vec2 b) {
    const vec2 ab = b - a;
    return abs(ab.x * (p.y - a.y) - ab.y * (p.x - a.x)) / max(length(ab), 1e-6);
}

void main() {
    const uvec2 px = gl_GlobalInvocationID.xy;
    if (px.x >= frame.width || px.y >= frame.height) return;
    const Surface s = surface_at(px);
    vec3 color = sky(s.dir);
    if (s.kind != surface_object && frame.debug_mode == 6u) {
        color = vec3(1.0, 0.0, 1.0);  // Holes: anything not drawn
    } else if (s.kind == surface_ground) {
        // The ground: a plane at y = 0 with a faint grid, fading into the
        // sky with distance.
        const vec2 cell = abs(fract(s.hit.xz * 0.5) - 0.5);
        const float line = smoothstep(0.47, 0.5, max(cell.x, cell.y));
        const vec3 ground = mix(vec3(0.42, 0.4, 0.37), vec3(0.33, 0.31, 0.29), line) *
                            (sun_color * max(sun_dir.y, 0.0) * 0.6 * sunlight(px, s) + sky(vec3(0, 1, 0)) * 0.45);
        color = mix(ground, color, 1.0 - exp(-s.t * 0.012));
    }
    if (s.kind != surface_sky && frame.debug_mode == 8u) {
        // Shadow levels: the virtual shadow map level each pixel reads, dark
        // where it is in shadow; magenta where no level had its pages.
        uint used = vsm_levels;
        const float lit = vsm_lookup(s.hit, s.n, s.t, used);
        color = used == vsm_levels ? vec3(1.0, 0.0, 1.0) : level_color(used * 2u) * (0.3 + 0.7 * lit);
    } else if (s.kind == surface_object) {
        const Instance inst = load_instance(s.vc.x);
        const Cluster c = clusters[s.vc.y];
        const uint vid = s.id >> 7;
        Material m = materials[min(inst.material, 5u)];
        if (frame.debug_mode != 0u) m = Material(vec3(0.56, 0.52, 0.47), 0.6, 0.0);
        if (frame.debug_mode == 1u) m.albedo = hash_color(s.vc.y * 7919u + s.vc.x * 104729u);
        else if (frame.debug_mode == 2u) m.albedo = hash_color(s.id * 2654435761u + s.vc.x);
        else if (frame.debug_mode == 3u) m.albedo = level_color(c.level);
        else if (frame.debug_mode == 4u) m.albedo = hash_color(c.group + s.vc.x * 104729u);
        else if (frame.debug_mode == 5u) m.albedo = hash_color(s.vc.x);
        else if (frame.debug_mode == 6u) m.albedo = vec3(0.3);
        else if (frame.debug_mode == 7u) m.albedo = vid >= pass_start[2] ? vec3(0.95, 0.45, 0.1) : vec3(0.15, 0.45, 0.95);

        const float lit = dot(s.n, sun_dir) > 0.0 ? sunlight(px, s) : 0.0;
        color = shade_material(m, s.n, -s.dir, lit);
        // Seen from behind: no rim light, which would outline every sliver.
        if (!s.behind) color += pow(1.0 - max(dot(s.n, -s.dir), 0.0), 4.0) * 0.25 * sky(s.n) * (1.0 - m.metallic);

        if ((frame.flags & flag_wireframe) != 0u) {
            const vec2 p = vec2(px) + 0.5;
            const vec2 s0 = to_pixel(s.p0), s1 = to_pixel(s.p1), s2 = to_pixel(s.p2);
            const float d = min(edge_distance(p, s0, s1), min(edge_distance(p, s1, s2), edge_distance(p, s2, s0)));
            color = mix(color * 0.25, color, smoothstep(0.0, 1.0, d));
        }
        color = mix(color, sky(s.dir), 1.0 - exp(-s.t * 0.012));
    }
    imageStore(out_image, ivec2(px), vec4(aces(color), 1.0));
}
