#version 460
#define RAY_QUERY  // built and run only with ray queries
// half resolution sun shadows: a ray per 2x2 pixels from the surface under the
// top-left one, stored with its distance so shade.comp knows which neighbours
// to borrow. ray queries only.
#include "common.glsl"
#include "surface.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    const uvec2 hp = gl_GlobalInvocationID.xy;
    const uvec2 size = shadow_size();
    if (hp.x >= size.x || hp.y >= size.y) return;
    const uvec2 px = min(hp * 2u, uvec2(frame.width, frame.height) - 1u);
    const Surface s = surface_at(px);
    shadow_mask[hp.x + hp.y * size.x] = vec2(trace_surface(s), s.kind == surface_sky ? -1.0 : s.t);
}
