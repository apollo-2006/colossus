#version 460
// a pass's indirect arguments, in rows of at most 65535 workgroups. step 0:
// cluster culling, a workgroup per work item, plus in pass 2 one per 64 hidden
// clusters. step 1: mesh draw and software raster, a workgroup per visible
// cluster.
#include "common.glsl"

layout(local_size_x = 1) in;

uvec3 rows(uint n) {
    return uvec3(min(n, 65535u), (n + 65534u) / 65535u, 1u);
}

void main() {
    const uint pass = push.pass;
    if (push.level == 3u) {
        // after cell culling.
        if (pass == 0u) {
            instance_args[0] = uvec4(rows(visible_cell_count[0]), 0u);
            late_cell_args = uvec4(rows((late_cell_count + 63u) / 64u), 0u);
        } else {
            instance_args[1] = uvec4(rows((late_instance_count + 63u) / 64u + visible_cell_count[1]), 0u);
        }
    } else if (push.level == 2u) {
        big_args[pass] = uvec4(rows(big_count[pass]), 0u);
    } else if (push.level == 0u) {
        const uint items = min(work_count[pass], frame.max_work_items);
        uint n = items;
        if (pass == 1u) n += (min(late_cluster_count, frame.max_visible) + 63u) / 64u;
        cull_args[pass] = uvec4(rows(n), items);
        if (pass == 0u) {
            pass_start[0] = 0u;
            sw_pass_start[0] = 0u;
        }
    } else {
        // the list's two ends must not cross: past their meeting, clusters drop
        // (counted as overflow).
        const uint hw_end = min(visible_count, frame.max_visible);
        const uint sw_end = min(sw_count, frame.max_visible - hw_end);
        pass_start[pass + 1u] = hw_end;
        sw_pass_start[pass + 1u] = sw_end;
        draw_args[pass] = uvec4(rows(hw_end - pass_start[pass]), pass_start[pass]);
        sw_args[pass] = uvec4(rows(sw_end - min(sw_pass_start[pass], sw_end)), sw_pass_start[pass]);
    }
}
