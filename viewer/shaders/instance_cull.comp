#version 460
// an invocation per instance: drops those out of view or hidden, hands cluster
// culling the clusters that might draw, in work items of 64. the workgroup
// writes all its instances' items after a prefix sum of their counts. near
// instances (thousands of items, neighbours in the list) over big_pieces go to
// expand.comp, a workgroup each.
//
// a workgroup per visible cell (cell_cull.comp). pass 1 tests against last
// frame's depth and lists what it hides; pass 2 runs that list, then the cells
// pass 2 found visible again, against pass 1's depth.
//
// clusters are by parent error and drawable only while the parent looks too
// coarse. nothing on the model is nearer than its lod sphere, so clusters with
// parent error under threshold * distance / (scale * lod_scale) are skipped by
// binary search: from afar, a short tail remains.
#include "common.glsl"

layout(local_size_x = 64) in;

const uint big_pieces = 16u;

shared uint ends[64];        // inclusive prefix sum of items
shared uint instance_of[64];
shared uint first_of[64];    // its first cluster
shared uint base;            // where the workgroup's items go

void main() {
    const uint pass = push.pass;
    const uint lane = gl_LocalInvocationIndex;
    const uint group = gl_WorkGroupID.y * 65535u + gl_WorkGroupID.x;
    // which instance: a visible cell's, or in pass 2 first those pass 1 hid
    // (inside the frustum already).
    bool valid = false, hidden_before = false;
    uint i = 0u;
    const uint late_groups = pass == 0u ? 0u : (late_instance_count + 63u) / 64u;
    if (group < late_groups) {
        const uint slot = group * 64u + lane;
        valid = slot < late_instance_count;
        if (valid) i = late_instances[slot];
        hidden_before = true;
    } else {
        const Cell cell = cells[cell_list[cells.length() * (1u + pass) + group - late_groups]];
        valid = lane < cell.count;
        i = cell.first + lane;
    }
    uint chunks = 0u;
    uint first = 0u;
    if (valid) {
        const Instance inst = load_instance(i);
        const Mesh m = meshes[inst.mesh];
        const vec3 center = to_world(inst, m.bounds.xyz);
        const float radius = m.bounds.w * inst.scale;
        bool keep = hidden_before || (frame.flags & flag_frustum_culling) == 0u || sphere_in_frustum(center, radius);
        // pass 1: was it hidden last frame, where it was last frame.
        const vec3 then = pass == 0u && inst.anim != 0u ? to_world(load_prev_instance(i), m.bounds.xyz) : center;
        if (keep && occluded(then, radius)) {
            if (pass == 0u) late_instances[atomicAdd(late_instance_count, 1u)] = i;
            else atomicAdd(stats.instances_occluded, 1u);
            keep = false;
        }
        if (keep) {
            atomicAdd(stats.instances_visible, 1u);
            const vec3 lc = to_world(inst, m.lod_bounds.xyz);
            const float d = max(length(lc - frame.cull_origin.xyz) - m.lod_bounds.w * inst.scale, frame.near_z);
            const float limit = frame.lod_threshold * d / (inst.scale * frame.lod_scale);
            uint lo = 0, hi = m.cluster_count;
            while (lo < hi) {
                const uint mid = (lo + hi) / 2;
                if (cluster_parent_error(m.first_cluster + mid) > limit) hi = mid;
                else lo = mid + 1;
            }
            chunks = (m.cluster_count - lo + 63u) / 64u;
            first = m.first_cluster + lo;
            if (chunks > big_pieces) {
                const uint at = big_instance(pass, atomicAdd(big_count[pass], 1u));
                late_instances[at] = i;
                late_instances[at + 1u] = first;
                late_instances[at + 2u] = chunks;
                chunks = 0u;
            }
        }
    }

    // prefix sum over the workgroup (hillis and steele).
    ends[lane] = chunks;
    instance_of[lane] = i;
    first_of[lane] = first;
    barrier();
    for (uint step = 1u; step < 64u; step <<= 1u) {
        const uint add = lane >= step ? ends[lane - step] : 0u;
        barrier();
        ends[lane] += add;
        barrier();
    }
    uint total = ends[63];
    if (total == 0u) return;
    if (lane == 0u) base = atomicAdd(work_count[pass], total);
    barrier();
    const uint at = base;
    if (at + total > frame.max_work_items) {
        if (lane == 0u) atomicAdd(stats.work_overflow, 1u);
        total = at < frame.max_work_items ? frame.max_work_items - at : 0u;
    }
    if (lane == 0u) atomicAdd(stats.work_items, total);
    for (uint k = lane; k < total; k += 64u) {
        // invocation whose run holds item k: the first end past it.
        uint lo = 0u, hi = 63u;
        while (lo < hi) {
            const uint mid = (lo + hi) / 2u;
            if (ends[mid] > k) hi = mid;
            else lo = mid + 1u;
        }
        const uint start = lo == 0u ? 0u : ends[lo - 1u];
        work[pass * frame.max_work_items + at + k] = WorkItem(instance_of[lo], first_of[lo] + 64u * (k - start));
    }
}
