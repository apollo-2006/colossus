#version 460
// ground-truth ambient occlusion (gtao, jimenez 2016; structure after intel's xegtao), at half
// resolution from the visibility buffer's depth. per pixel: two slices, rotated per frame so
// taa averages them; along each, the highest horizon either side within ao_radius, integrated
// against the depth-derived normal's cosine lobe. 1 is open, 0 shut.
//
// and the light arriving from everything but the sun (indirect light, half resolution being
// plenty for it): the sky and the ground bounce of ambient_light(), times the occlusion, plus
// what nearby surfaces bounce. that last is screen space: each horizon sample that newly hides
// part of the hemisphere sends, over that part's cosine weight, the light it showed last frame
// (the history, reprojected, its tone curve undone). bounces add up over frames.
//
// out: rgb the indirect light, a the occlusion.
#extension GL_EXT_shader_atomic_int64 : require
#include "common.glsl"
#include "surface.glsl"
#include "vsm.glsl"
#include "lighting.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 35, rgba16f) uniform writeonly image2D ao_out;
layout(set = 0, binding = 21) uniform sampler2D history;  // last frame's image (taa.comp)

const float ao_radius = 0.25;  // world units
const uint ao_slices = 2u;
const uint ao_steps = 5u;      // per side
const float pi = 3.14159265;
const float ao_power = 2.2;    // xegtao's final power: the integral alone reads faint

layout(set = 0, binding = 37) uniform sampler2D ao_depth;  // ao_depth.comp's levels

// view-space position of a depth texel at a level: its representative full-resolution pixel
// (the block's top-left) along its ray.
vec3 view_position(ivec2 q, int level) {
    const ivec2 size = textureSize(ao_depth, level);
    q = clamp(q, ivec2(0), size - 1);
    const vec2 px = vec2(q << (level + 1)) + 0.5;
    const vec2 ndc = px / vec2(frame.width, frame.height) * 2.0 - 1.0;
    const vec3 ray = vec3(ndc.x / frame.p00, -ndc.y / frame.p11, -1.0);  // at w = 1; ndc y runs down
    return ray * texelFetch(ao_depth, q, level).x;
}

// the light a view-space point showed last frame: reprojected into the history, tone curve
// undone. black off screen.
vec3 last_light(mat4 to_world_space, vec3 view_p) {
    const vec4 clip = frame.prev_view_proj * (to_world_space * vec4(view_p, 1.0));
    if (clip.w <= 0.0) return vec3(0.0);
    const vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec3(0.0);
    return aces_inverse(textureLod(history, uv, 0.0).rgb);
}

#ifdef RAY_QUERY
#extension GL_EXT_ray_tracing_position_fetch : require
// --gi rt: bounce light traced in world space, against the shadow copies (the coarsest: a bounce
// needs no finer), so surfaces off screen or behind others bounce too, and statues light the
// ground. four cosine rays a pixel, turned each frame for taa. a hit shows its material lit by
// the sun (a shadow ray) and the sky; a ray down to open ground takes the ground's light; one
// up, the sky. returns the light arriving, occlusion included.
struct Hit {
    float t;
    vec3 n;         // world, facing the ray
    uint instance;
};

bool closest_hit(accelerationStructureEXT scene, vec3 start, vec3 dir, float far, inout Hit hit) {
    rayQueryEXT q;
    rayQueryInitializeEXT(q, scene, gl_RayFlagsOpaqueEXT, 4u, start, 0.0, dir, far);
    while (rayQueryProceedEXT(q)) {
    }
    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionNoneEXT) return false;
    const float t = rayQueryGetIntersectionTEXT(q, true);
    if (t >= hit.t) return false;
    vec3 v[3];
    rayQueryGetIntersectionTriangleVertexPositionsEXT(q, true, v);
    const mat4x3 to_world_m = rayQueryGetIntersectionObjectToWorldEXT(q, true);
    vec3 n = normalize(mat3(to_world_m) * cross(v[1] - v[0], v[2] - v[0]));
    if (dot(n, dir) > 0.0) n = -n;
    hit = Hit(t, n, rayQueryGetIntersectionInstanceCustomIndexEXT(q, true) & 0xffffffu);
    return true;
}

vec3 traced_light(vec3 p, vec3 n, float noise) {
    const vec3 t = normalize(abs(n.y) < 0.9 ? cross(n, vec3(0, 1, 0)) : cross(n, vec3(1, 0, 0))), b = cross(n, t);
    const vec3 start = p + n * (1e-3 + frame.shadow_lod_error[2] * 1.15 * 1.5);
    vec3 sum = vec3(0.0);
    for (uint k = 0u; k < 4u; ++k) {
        const float r = sqrt((float(k) + 0.5) / 4.0), a = float(k) * 2.39996 + noise * 6.2831853;
        const vec3 dir = normalize(t * (r * cos(a)) + b * (r * sin(a)) + n * sqrt(max(1.0 - r * r, 0.0)));
        // the ground, or as far as anything stands.
        const float ground_t = dir.y < 0.0 && start.y > 0.0 ? -start.y / dir.y : 1e30;
        const float far = min(ground_t, dir.y > 0.0 ? max((frame.scene_top - start.y) / dir.y, 0.0) : ground_t);
        Hit hit = Hit(far, vec3(0.0), 0u);
        bool found = closest_hit(shadow_scene, start, dir, far, hit);
        if ((frame.flags & flag_moving) != 0u) found = closest_hit(shadow_moving, start, dir, far, hit) || found;
        if (found) {
            const vec3 h = start + dir * hit.t;
            const float nl = max(dot(hit.n, sun_dir), 0.0);
            const float lit = nl > 0.0 ? trace_sun(h, hit.n, 1e-3 + frame.shadow_lod_error[2] * 1.15 * 1.5, 4u) : 0.0;
            const vec3 albedo = materials[min(instances[hit.instance].material, 5u)].albedo;
            sum += albedo * (sun_color * nl * lit + sky(vec3(0.0, 1.0, 0.0)) * 0.42);
        } else if (dir.y < 0.0 && start.y > 0.0) {
            sum += ground_radiance(ground_lit(start + dir * ground_t), 1.0);
        } else {
            sum += sky(vec3(0.0, 1.0, 0.0)) * 0.42;
        }
    }
    return sum * 0.25;
}
#endif

// interleaved gradient noise (jimenez 2014).
float noise(vec2 p) {
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

void main() {
    const ivec2 half_px = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(ao_out);
    if (any(greaterThanEqual(half_px, size))) return;
    const vec3 p = view_position(half_px, 0);
    if (-p.z > 1e4) {
        vec3 ground_light = vec3(0.0);
#ifdef RAY_QUERY
        // the ground, with --gi rt: what the statues around it bounce.
        if ((frame.flags & flag_gi_rt) != 0u) {
            const vec2 px = vec2(half_px * 2) + 0.5;
            const vec2 ndc = px / vec2(frame.width, frame.height) * 2.0 - 1.0;
            const vec4 near_point = frame.inv_view_proj * vec4(ndc, 1.0, 1.0);
            const vec3 dir = normalize(near_point.xyz / near_point.w - frame.origin.xyz);
            if (dir.y < 0.0) {
                const vec3 g = frame.origin.xyz + dir * (-frame.origin.y / dir.y);
                ground_light = traced_light(g, vec3(0.0, 1.0, 0.0), noise(vec2(half_px) + float(frame.frame_index % 64u) * 3.17));
            }
        }
#endif
        imageStore(ao_out, half_px, vec4(ground_light, 1.0));
        return;
    }
    // normal from depth: the smaller difference either side, so edges don't smear.
    const vec3 l = view_position(half_px - ivec2(1, 0), 0), r = view_position(half_px + ivec2(1, 0), 0);
    const vec3 u = view_position(half_px - ivec2(0, 1), 0), d = view_position(half_px + ivec2(0, 1), 0);
    const vec3 dx = abs(r.z - p.z) < abs(p.z - l.z) ? r - p : p - l;
    const vec3 dy = abs(d.z - p.z) < abs(p.z - u.z) ? d - p : p - u;
    vec3 n = normalize(cross(dy, dx));
    const vec3 v = normalize(-p);
    if (dot(n, v) < 0.0) n = -n;

    // world space, for the ground's bounce and reading last frame.
    const mat4 to_world_space = inverse(frame.view);
    const vec3 world_p = (to_world_space * vec4(p, 1.0)).xyz, world_n = normalize(mat3(to_world_space) * n);
    // bounced off nearby surfaces: needs last frame's image to fit this one.
    const bool bounce = (frame.flags & flag_bounce) != 0u && frame.taa_valid != 0u && (frame.flags & flag_gi_rt) == 0u;
    vec3 bounced = vec3(0.0);

    const float radius_px = min(ao_radius * frame.lod_scale / max(-p.z, frame.near_z), 96.0);
    const float sky_noise = noise(vec2(half_px) + float(frame.frame_index % 64u) * 3.17);
    if (radius_px < 1.0) {
#ifdef RAY_QUERY
        if ((frame.flags & flag_gi_rt) != 0u) {
            imageStore(ao_out, half_px, vec4(traced_light(world_p, world_n, sky_noise), 1.0));
            return;
        }
#endif
        imageStore(ao_out, half_px, vec4(ambient_light(world_p, world_n, 1.0, sky_noise), 1.0));
        return;
    }
    const float falloff_range = 0.615 * ao_radius;
    const float falloff_mul = -1.0 / falloff_range;
    const float falloff_add = (ao_radius - falloff_range) / falloff_range + 1.0;
    const vec2 jitter = vec2(noise(vec2(half_px) + float(frame.frame_index % 64u) * 5.588238),
                             noise(vec2(half_px.yx) + float(frame.frame_index % 64u) * 7.123));

    float visibility = 0.0;
    for (uint slice = 0u; slice < ao_slices; ++slice) {
        const float phi = (float(slice) + jitter.x) * pi / float(ao_slices);
        const vec2 omega = vec2(cos(phi), sin(phi));  // screen, y down
        const vec3 direction = vec3(omega.x, -omega.y, 0.0);  // view, y up
        const vec3 ortho = direction - dot(direction, v) * v;
        const vec3 axis = normalize(cross(ortho, v));
        const vec3 projected = n - axis * dot(n, axis);
        const float projected_length = length(projected);
        const float cos_n = clamp(dot(projected, v) / max(projected_length, 1e-6), 0.0, 1.0);
        const float angle_n = sign(dot(ortho, projected)) * acos(cos_n);
        float horizon0 = cos(angle_n + pi * 0.5), horizon1 = cos(angle_n - pi * 0.5);
        const float low0 = horizon0, low1 = horizon1;
        // the visible cosine weight from the normal to a horizon at angle a (gtao's integral).
        #define ARC(a) ((cos_n + 2.0 * (angle_n + clamp((a) - angle_n, -pi * 0.5, pi * 0.5)) * sin(angle_n) - \
                         cos(2.0 * (angle_n + clamp((a) - angle_n, -pi * 0.5, pi * 0.5)) - angle_n)) * 0.25)
        for (uint step = 0u; step < ao_steps; ++step) {
            // quadratic spacing, dense near the pixel; in half-resolution texels, far taps on
            // coarser levels.
            float s = (float(step) + jitter.y) / float(ao_steps);
            s = max(s * s * radius_px * 0.5, 1.0);
            const int level = clamp(int(log2(s)) - 1, 0, 3);
            const ivec2 a0 = (half_px + ivec2(round(omega * s))) >> level;
            const ivec2 a1 = (half_px - ivec2(round(omega * s))) >> level;
            const vec3 h0 = view_position(a0, level) - p, h1 = view_position(a1, level) - p;
            const float d0 = length(h0), d1 = length(h1);
            const float w0 = clamp(d0 * falloff_mul + falloff_add, 0.0, 1.0);
            const float w1 = clamp(d1 * falloff_mul + falloff_add, 0.0, 1.0);
            const float c0 = mix(low0, dot(h0 / max(d0, 1e-6), v), w0), c1 = mix(low1, dot(h1 / max(d1, 1e-6), v), w1);
            if (bounce && c0 > horizon0) {
                const float hidden = abs(ARC(acos(clamp(horizon0, -1.0, 1.0))) - ARC(acos(clamp(c0, -1.0, 1.0))));
                bounced += projected_length * hidden * last_light(to_world_space, p + h0);
            }
            if (bounce && c1 > horizon1) {
                const float hidden = abs(ARC(-acos(clamp(horizon1, -1.0, 1.0))) - ARC(-acos(clamp(c1, -1.0, 1.0))));
                bounced += projected_length * hidden * last_light(to_world_space, p + h1);
            }
            horizon0 = max(horizon0, c0);
            horizon1 = max(horizon1, c1);
        }
        float a0 = -acos(clamp(horizon1, -1.0, 1.0)), a1 = acos(clamp(horizon0, -1.0, 1.0));
        a0 = angle_n + clamp(a0 - angle_n, -pi * 0.5, pi * 0.5);
        a1 = angle_n + clamp(a1 - angle_n, -pi * 0.5, pi * 0.5);
        const float arc0 = (cos_n + 2.0 * a0 * sin(angle_n) - cos(2.0 * a0 - angle_n)) * 0.25;
        const float arc1 = (cos_n + 2.0 * a1 * sin(angle_n) - cos(2.0 * a1 - angle_n)) * 0.25;
        visibility += projected_length * (arc0 + arc1);
    }
    const float ao = pow(clamp(visibility / float(ao_slices), 0.0, 1.0), ao_power);
#ifdef RAY_QUERY
    if ((frame.flags & flag_gi_rt) != 0u) {
        // traced for the large scale; the occlusion pass keeps the small (the copies are coarse).
        imageStore(ao_out, half_px, vec4(traced_light(world_p, world_n, sky_noise) * ao, ao));
        return;
    }
#endif
    // the bounce at the scale ambient light is drawn at (the sky's 0.42 in ambient_light()): at
    // full strength it fed back over frames until shadow sides lost their shape.
    const vec3 indirect = ambient_light(world_p, world_n, ao, sky_noise) + bounced * (0.42 / float(ao_slices));
    imageStore(ao_out, half_px, vec4(indirect, ao));
}
