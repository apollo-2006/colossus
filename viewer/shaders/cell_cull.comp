#version 460
// culls cells of up to 64 neighbouring instances, an invocation each, before
// their instances are read (at a million, reading them all was most of
// culling). pass 1 tests frustum and last frame's depth and lists hidden cells;
// pass 2 tests those against pass 1's depth. visible cells' instances go to
// instance_cull.comp.
#include "common.glsl"

layout(local_size_x = 64) in;

void main() {
    const uint pass = push.pass;
    const uint n = pass == 0u ? cells.length() : late_cell_count;
    const uint k = (gl_WorkGroupID.y * 65535u + gl_WorkGroupID.x) * 64u + gl_LocalInvocationIndex;
    if (k >= n) return;
    const uint c = pass == 0u ? k : cell_list[k];
    const Cell cell = cells[c];
    if (pass == 0u && (frame.flags & flag_frustum_culling) != 0u && !sphere_in_frustum(cell.center, cell.radius)) return;
    // the sphere holds moving instances wherever they go, last frame included.
    if (occluded(cell.center, cell.radius)) {
        if (pass == 0u) cell_list[atomicAdd(late_cell_count, 1u)] = c;
        return;
    }
    cell_list[cells.length() * (1u + pass) + atomicAdd(visible_cell_count[pass], 1u)] = c;
}
